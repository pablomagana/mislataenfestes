# Los assets con hash SIEMPRE deben resolverse como fichero real.
# Si no existe, devolver 404 (NUNCA el index.html), para evitar que el
# fallback SPA sirva HTML con Content-Type de JS y Cloudflare lo cachee
# como asset immutable (bug que dejaba la web en blanco).
/assets/*   /assets/:splat   404

# SPA fallback para rutas de la aplicación
/about    /index.html   200
/*        /index.html   200