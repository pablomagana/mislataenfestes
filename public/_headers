# Headers para Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Assets con hash de Vite (/assets/*). Cloudflare Pages ya sirve el MIME
# correcto por extensión, así que NO forzamos Content-Type (evita disfrazar
# de JS el HTML del fallback SPA). Usamos revalidación por ETag en lugar de
# 'immutable': si por una carrera de deploy el fallback llega a servirse en
# una URL de asset, esa respuesta NO queda cacheada 1 año y se autocura.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Archivos de fuentes
/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Content-Type: font/woff
  Cache-Control: public, max-age=31536000, immutable

# Archivos de imágenes
/*.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=31536000, immutable

# HTML (documento de entrada y rutas SPA): siempre revalidar para
# evitar servir un index.html obsoleto que apunte a assets con hash antiguo.
/
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/about
  Cache-Control: public, max-age=0, must-revalidate
/evento/*
  Cache-Control: public, max-age=0, must-revalidate

# JSON
/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
